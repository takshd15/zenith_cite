{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "functions": {
    "api/*.js": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/Zenith_Website_Layout.html" },
    { "source": "/book", "destination": "/book/index.html" },
    { "source": "/ai-visibility-audit", "destination": "/ai-visibility-audit/index.html" },
    { "source": "/generative-engine-optimisation", "destination": "/generative-engine-optimisation/index.html" },
    { "source": "/about", "destination": "/about/index.html" },
    { "source": "/insights", "destination": "/insights/index.html" },
    { "source": "/privacy", "destination": "/privacy/index.html" },
    { "source": "/terms", "destination": "/terms/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
